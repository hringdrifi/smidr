{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smidr",
  "version": "0.2.20",
  "identifier": "app.smidr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Smidr",
        "width": 1280,
        "height": 900,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
